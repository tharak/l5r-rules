rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function owner(u) { return signed() && request.auth.uid == u; }
    function campaign(c) { return get(/databases/$(database)/documents/campaigns/$(c)).data; }
    function gm(c) { return signed() && campaign(c).gmUid == request.auth.uid; }
    function member(c,u) {
      return exists(/databases/$(database)/documents/campaigns/$(c))
        && exists(/databases/$(database)/documents/campaigns/$(c)/members/$(u));
    }
    function joined(c) { return signed() && member(c,request.auth.uid); }
    function validPC(c,pc,u,id) {
      let data = get(/databases/$(database)/documents/campaigns/$(c)/pcs/$(pc)).data;
      return data.ownerUid == u && data.characterId == id && member(c,u)
        && data.membershipId == get(/databases/$(database)/documents/campaigns/$(c)/members/$(u)).data.membershipId;
    }
    // The GM of a campaign this PC is linked to, holding a valid full grant.
    function granted(u,id) {
      let grant = get(/databases/$(database)/documents/users/$(u)/characters/$(id)/grants/$('full_' + request.auth.uid)).data;
      return signed() && joined(grant.campaignId) && gm(grant.campaignId)
        && grant.membershipId == get(/databases/$(database)/documents/campaigns/$(grant.campaignId)/members/$(request.auth.uid)).data.membershipId
        && validPC(grant.campaignId,grant.pcId,u,id);
    }
    // The public profile: always-public details and the items ticked Public (built by
    // sheet-sharing.js). Its keys and size are limited; its content is the owner's choice.
    function profileShape(p) {
      return p is map && p.keys().hasOnly(['name','portrait','clan','family','school','insightRank','gear','stats','advantages','disadvantages','journal'])
        && (!('portrait' in p) || (p.portrait is string && p.portrait.size() <= 120000))
        && (!('stats' in p) || (p.stats is map && p.stats.keys().hasOnly(['honor','glory','status','taint'])))
        && (!('journal' in p) || p.journal is list);
    }
    function validFull(u,id) {
      let f = request.resource.data;
      let p = getAfter(/databases/$(database)/documents/users/$(u)/publicCharacters/$(id)).data;
      return f.keys().hasAll(['sheetJson','updatedAt','revision','profile'])
        && f.keys().hasOnly(['sheetJson','updatedAt','revision','profile'])
        && f.sheetJson is string && f.sheetJson.size() <= 400000
        && f.updatedAt is string && f.updatedAt.size() <= 40 && f.revision is string && f.revision.size() <= 80
        && profileShape(f.profile)
        && p.keys().hasOnly(['revision','profile']) && p.revision == f.revision && p.profile == f.profile;
    }
    // The full sheet: its owner and the GM read it; only the owner writes it. Listing stays
    // owner-only so sheets cannot be enumerated.
    match /users/{u}/characters/{id} {
      allow list: if owner(u);
      allow get: if owner(u) || granted(u,id);
      allow create, update: if owner(u) && validFull(u,id);
      allow delete: if owner(u) && !existsAfter(/databases/$(database)/documents/users/$(u)/publicCharacters/$(id));
      match /grants/{viewer} {
        allow get: if owner(u) || (signed() && viewer in ['full_' + request.auth.uid,'public_' + request.auth.uid]);
        allow create, update: if signed() && (viewer == 'public_' + request.auth.uid || (viewer == 'full_' + request.auth.uid && gm(request.resource.data.campaignId))) && request.resource.data.keys().hasOnly(['campaignId','pcId','membershipId'])
          && request.resource.data.membershipId == get(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)/members/$(request.auth.uid)).data.membershipId
          && joined(request.resource.data.campaignId)
          && validPC(request.resource.data.campaignId,request.resource.data.pcId,u,id);
        allow delete: if owner(u) || (signed() && viewer in ['full_' + request.auth.uid,'public_' + request.auth.uid]);
      }
      // GM journal entries (the player's own entries live in the sheet). Anyone reads an entry
      // marked public; the owner and the GM read every entry. Only the GM writes them, each
      // author edits only their own, and the sheet owner may delete any.
      match /journal/{entry} {
        function entryShape(d) {
          return d.keys().hasAll(['authorUid','authorName','text','public','createdAt','updatedAt'])
            && d.keys().hasOnly(['authorUid','authorName','title','text','public','createdAt','updatedAt'])
            && (!('title' in d) || (d.title is string && d.title.size() <= 200))
            && d.authorUid is string && d.authorName is string && d.authorName.size() <= 200
            && d.text is string && d.text.size() > 0 && d.text.size() <= 20000 && d.public is bool
            && d.createdAt is string && d.createdAt.size() <= 40 && d.updatedAt is string && d.updatedAt.size() <= 40;
        }
        allow get, list: if resource.data.public == true || owner(u) || granted(u,id);
        allow create: if granted(u,id) && request.resource.data.authorUid == request.auth.uid && entryShape(request.resource.data);
        allow update: if granted(u,id) && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid && request.resource.data.createdAt == resource.data.createdAt
          && entryShape(request.resource.data);
        allow delete: if owner(u) || (signed() && resource.data.authorUid == request.auth.uid);
      }
    }
    // The public profile: anyone with the link reads it; it always mirrors the full sheet's.
    match /users/{u}/publicCharacters/{id} {
      allow list: if owner(u);
      allow get: if true;
      allow create, update: if owner(u) && request.resource.data.keys().hasOnly(['revision','profile'])
        && getAfter(/databases/$(database)/documents/users/$(u)/characters/$(id)).data.revision == request.resource.data.revision
        && getAfter(/databases/$(database)/documents/users/$(u)/characters/$(id)).data.profile == request.resource.data.profile;
      allow delete: if owner(u) && !existsAfter(/databases/$(database)/documents/users/$(u)/characters/$(id));
    }
    match /users/{u}/campaigns/{c} {
      allow read: if owner(u);
      allow create: if (owner(u) || gm(c)) && request.resource.data.keys().hasOnly(['gmUid','membershipId'])
        && request.resource.data.gmUid == getAfter(/databases/$(database)/documents/campaigns/$(c)).data.gmUid
        && request.resource.data.membershipId == getAfter(/databases/$(database)/documents/campaigns/$(c)/members/$(u)).data.membershipId;
      allow delete: if (owner(u) || gm(c)) && !existsAfter(/databases/$(database)/documents/campaigns/$(c)/members/$(u));
    }
    match /campaigns/{c} {
      allow read: if joined(c);
      allow create: if signed() && request.resource.data.keys().hasOnly(['title','gmUid'])
        && request.resource.data.gmUid == request.auth.uid && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && getAfter(/databases/$(database)/documents/campaigns/$(c)/members/$(request.auth.uid)).data.gmUid == request.auth.uid;
      // The GM edits the title and which PCs/NPCs appear on the timeline picker.
      allow update: if gm(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','timelineHidden'])
        && (!('timelineHidden' in request.resource.data) || (request.resource.data.timelineHidden is list && request.resource.data.timelineHidden.size() <= 1000))
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200;
      allow delete: if gm(c);
      match /members/{u} {
        function validName() {
          return !('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 200);
        }
        function invitation() {
          let i = get(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken)).data;
          return i.campaignId == c && i.expiresAt > request.time && i.gmUid == getAfter(/databases/$(database)/documents/campaigns/$(c)).data.gmUid;
        }
        allow read: if joined(c);
        allow create: if owner(u) && request.resource.data.keys().hasOnly(['gmUid','membershipId','inviteToken','displayName']) && validName()
          && request.resource.data.membershipId is string && request.resource.data.membershipId.size() <= 80
          && request.resource.data.gmUid == getAfter(/databases/$(database)/documents/campaigns/$(c)).data.gmUid
          && (request.resource.data.gmUid == u || invitation())
          && getAfter(/databases/$(database)/documents/users/$(u)/campaigns/$(c)).data.membershipId == request.resource.data.membershipId;
        allow update: if owner(u) && joined(c) && validName()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
        allow delete: if ((gm(c) && (campaign(c).gmUid != u || !existsAfter(/databases/$(database)/documents/campaigns/$(c)))) || (owner(u) && campaign(c).gmUid != u))
          && !existsAfter(/databases/$(database)/documents/users/$(u)/campaigns/$(c));
      }
      match /sessions/{id} {
        allow read: if joined(c);
        // Up to four small images (cropped like character pictures) fit beside the text.
        allow create, update: if gm(c) && request.resource.data.keys().hasOnly(['title','text','createdAt','updatedAt','images'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 200
          && request.resource.data.text is string && request.resource.data.text.size() <= 500000
          && (!('images' in request.resource.data) || (request.resource.data.images is list && request.resource.data.images.size() <= 4))
          && (!('createdAt' in request.resource.data) || (request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40))
          && request.resource.data.updatedAt is string;
        allow delete: if gm(c);
      }
      // Timeline events: a note about a PC, NPC or plot, pinned on the map within a session.
      // Every member reads them; only the GM writes them.
      match /timeline/{id} {
        allow read: if joined(c);
        allow create, update: if gm(c) && request.resource.data.keys().hasOnly(['sessionId','kind','targetId','noteId','x','y','createdAt','updatedAt'])
          && request.resource.data.kind in ['pcs','npcs','plots']
          && request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 80
          && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 80
          && request.resource.data.noteId is string && request.resource.data.noteId.size() <= 80
          && request.resource.data.x is number && request.resource.data.x >= 0 && request.resource.data.x <= 100
          && request.resource.data.y is number && request.resource.data.y >= 0 && request.resource.data.y <= 100
          && request.resource.data.createdAt is string && request.resource.data.updatedAt is string;
        allow delete: if gm(c);
      }
      // Read marks: every member sees who has read what; each member writes only their own.
      match /reads/{u} {
        allow read: if joined(c);
        allow create, update: if owner(u) && joined(c) && request.resource.data.keys().hasOnly(['name','marks'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 200
          && request.resource.data.marks is map && request.resource.data.marks.size() <= 2000;
        allow delete: if owner(u) || gm(c);
      }
      // NPCs are public to every member; only the GM writes them.
      match /npcs/{id} {
        allow read: if joined(c);
        // An optional picture is a small inline image, the same shape the client renders.
        allow create, update: if gm(c) && request.resource.data.keys().hasOnly(['name','notes','updatedAt','portrait'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 200
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 900000
          && request.resource.data.updatedAt is string
          && (!('portrait' in request.resource.data) || (request.resource.data.portrait is string
            && request.resource.data.portrait.size() <= 120000
            && request.resource.data.portrait.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/]+={0,2}$')));
        allow delete: if gm(c);
      }
      match /pcs/{id} {
        allow read: if joined(c);
        allow create: if joined(c) && request.resource.data.keys().hasOnly(['ownerUid','characterId','membershipId'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.characterId is string
          && request.resource.data.membershipId == get(/databases/$(database)/documents/campaigns/$(c)/members/$(request.auth.uid)).data.membershipId
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/characters/$(request.resource.data.characterId));
        allow delete: if gm(c) || (joined(c) && resource.data.ownerUid == request.auth.uid);
      }
      match /{kind}/{id} {
        function entryKind() { return kind in ['plots','notes']; }
        function targetReadable(m) {
          return kind == 'plots' || (m.targetKind in ['sessions','pcs','npcs','plots']
            && exists(/databases/$(database)/documents/campaigns/$(c)/$(m.targetKind)/$(m.targetId))
            && (m.targetKind != 'plots' || get(/databases/$(database)/documents/campaigns/$(c)/plots/$(m.targetId)).data.creatorUid == m.targetCreatorUid));
        }
        function validMetadata() {
          let m = request.resource.data;
          let body = getAfter(/databases/$(database)/documents/campaigns/$(c)/$(kind)/$(id)/content/body).data;
          return m.keys().hasAll(['creatorUid','public','createdAt','updatedAt','revision'])
            && m.keys().hasOnly(kind == 'plots'
              ? ['creatorUid','public','createdAt','updatedAt','revision']
              : ['creatorUid','public','createdAt','updatedAt','revision','targetKind','targetId','targetCreatorUid'])
            && m.creatorUid == request.auth.uid && m.public is bool
            && m.createdAt is string && m.createdAt.size() <= 40
            && m.updatedAt is string && m.updatedAt.size() <= 40
            && m.revision is string && m.revision.size() > 0 && m.revision.size() <= 80
            && body.revision == m.revision
            && (kind == 'plots' || (m.targetKind is string && m.targetId is string && m.targetId.size() > 0 && m.targetId.size() <= 80))
            && (kind == 'plots' || (m.targetKind == 'plots'
              ? (m.targetCreatorUid is string && m.targetCreatorUid.size() > 0 && m.targetCreatorUid.size() <= 128)
              : !('targetCreatorUid' in m)))
            && targetReadable(m);
        }
        function parentOwner(m) {
          return kind == 'notes' && (
            (m.targetKind == 'plots' && get(/databases/$(database)/documents/campaigns/$(c)/plots/$(m.targetId)).data.creatorUid == request.auth.uid)
            || (m.targetKind == 'pcs' && get(/databases/$(database)/documents/campaigns/$(c)/pcs/$(m.targetId)).data.ownerUid == request.auth.uid));
        }
        // Only ownership, visibility, and attachment metadata are shared. Text lives in protected bodies.
        allow read: if entryKind() && joined(c);
        // Journal entries (stored as notes): anyone on sessions, the GM on NPCs, the GM or the
        // plot's creator on plots. PC journals live with the character, so no new PC notes.
        function canAddEntry(m) {
          return kind == 'plots' || m.targetKind == 'sessions' || (m.targetKind == 'npcs' && gm(c))
            || (m.targetKind == 'plots' && (gm(c) || get(/databases/$(database)/documents/campaigns/$(c)/plots/$(m.targetId)).data.creatorUid == request.auth.uid));
        }
        allow create: if entryKind() && joined(c) && validMetadata() && canAddEntry(request.resource.data);
        allow update: if entryKind() && joined(c) && resource.data.creatorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['public','updatedAt','revision']) && validMetadata();
        allow delete: if entryKind() && joined(c) && (resource.data.creatorUid == request.auth.uid || gm(c) || parentOwner(resource.data))
          && !existsAfter(/databases/$(database)/documents/campaigns/$(c)/$(kind)/$(id)/content/body);
        match /content/{bodyId} {
          function metadata() { return get(/databases/$(database)/documents/campaigns/$(c)/$(kind)/$(id)).data; }
          function validBody() {
            let m = getAfter(/databases/$(database)/documents/campaigns/$(c)/$(kind)/$(id)).data;
            let b = request.resource.data;
            return m.creatorUid == request.auth.uid && targetReadable(m)
              && b.keys().hasAll(kind == 'plots' ? ['title','text','revision'] : ['text','revision'])
              && b.keys().hasOnly(kind == 'plots' ? ['title','text','revision','images'] : ['title','text','revision'])
              && (!('images' in b) || (b.images is list && b.images.size() <= 4))
              && (kind == 'plots' || !('title' in b) || (b.title is string && b.title.size() <= 200))
              && b.text is string && (kind == 'plots' || b.text.size() > 0) && b.text.size() <= 400000
              && b.revision == m.revision
              && (kind != 'plots' || (b.title is string && b.title.size() > 0 && b.title.size() <= 200));
          }
          // Privacy is paused: every campaign member reads every plot and note body.
          allow get: if entryKind() && bodyId == 'body' && joined(c) && targetReadable(metadata());
          allow create, update: if entryKind() && bodyId == 'body' && joined(c) && validBody();
          allow delete: if entryKind() && bodyId == 'body' && joined(c)
            && (metadata().creatorUid == request.auth.uid || gm(c) || parentOwner(metadata()));
        }
      }
      match /private/{id} {
        allow read: if gm(c);
        allow create, update: if gm(c) && id == 'invitation' && request.resource.data.keys().hasOnly(['token'])
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.campaignId == c;
        allow delete: if gm(c);
      }
    }
    match /invites/{token} {
      allow get: if signed() && resource.data.expiresAt > request.time;
      allow create: if gm(request.resource.data.campaignId)
        && request.resource.data.keys().hasOnly(['campaignId','gmUid','createdAt','expiresAt'])
        && request.resource.data.gmUid == request.auth.uid
        && request.resource.data.createdAt is timestamp && request.resource.data.expiresAt is timestamp
        && request.resource.data.createdAt <= request.time && request.resource.data.createdAt > request.time - duration.value(5,'m')
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7,'d')
        && getAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)/private/invitation).data.token == token;
      allow delete: if gm(resource.data.campaignId);
    }
  }
}
